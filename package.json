{
  "name": "electron-angular-boilerplate",
  "version": "0.0.0",
  "description": "Boilerplate for an Angular frontend in Electron, with a shared, runtime-validated API contract and a SQLite database.",
  "keywords": [
    "Angular",
    "Electron",
    "boilerplate",
    "sqlite"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "workspaces/*"
  ],
  "scripts": {
    "start": "npm run build:shared && concurrently \"npm run watch:shared\" \"npm run start:angular-app\" \"npm run start:electron-app\"",
    "start:angular-app": "npm --workspace=workspaces/angular-app run start",
    "start:electron-app": "npm --workspace=workspaces/electron-app run start",
    "watch:shared": "npm --workspace=workspaces/shared run watch",
    "build": "npm run build:shared && npm run build:electron-app && npm run build:angular-app && npm run copy:renderer",
    "build:shared": "npm --workspace=workspaces/shared run build",
    "build:electron-app": "npm --workspace=workspaces/electron-app run build",
    "build:angular-app": "npm --workspace=workspaces/angular-app run build",
    "copy:renderer": "node workspaces/electron-app/scripts/copy-renderer.mjs",
    "prepackage": "npm run build && node workspaces/electron-app/scripts/ensure-node-modules-stub.mjs && node workspaces/electron-app/scripts/vendor-shared.mjs",
    "package": "electron-builder",
    "postpackage": "node workspaces/electron-app/scripts/vendor-shared.mjs --remove",
    "test": "npm run test --workspace=workspaces/shared --workspace=workspaces/electron-app --workspace=workspaces/angular-app",
    "test:coverage": "npm run test:coverage --workspace=workspaces/shared --workspace=workspaces/electron-app --workspace=workspaces/angular-app",
    "coverage:summary": "node scripts/coverage-summary.mjs",
    "package:dir": "npm run package -- --dir --publish never",
    "test:e2e": "npm run package:dir && npm --workspace=workspaces/e2e run test",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "build": {
    "appId": "com.electronangularboilerplate.app",
    "productName": "Electron Angular Boilerplate",
    "directories": {
      "app": "workspaces/electron-app",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github"
      }
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
