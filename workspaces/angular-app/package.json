{
  "name": "angular-app",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "lint": "eslint --ext .ts,.js,.html . || exit 0",
    "lint:fix": "eslint --ext .ts,.js,.html . --fix",
    "start": "ng serve",
    "build": "ng build --base-href ./",
