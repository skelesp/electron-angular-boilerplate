{
  "extends": "../../tsconfig.json", // Extend the root tsconfig
  "compilerOptions": {
    "module": "CommonJS",
    "rootDir": "./src",
    "outDir": "./dist",
    "allowJs": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "composite": true,
    "declaration": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "src/test-utils/**"],
  "references": [{ "path": "../shared" }],
  "ts-node": {
    // The TypeORM CLI (migration:generate/run/revert) runs through ts-node against this
    // tsconfig. Type-checking is skipped here (ts-node 10's checker predates this repo's
    // TypeScript version and misresolves @types/node through the workspace hoist) - `tsc
    // --build` is still what type-checks the project for `npm run build`.
    "transpileOnly": true
  }
}
