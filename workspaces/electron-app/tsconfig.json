{
  "extends": "../../tsconfig.json", // Extend the root tsconfig
  "compilerOptions": {
    "module": "CommonJS",
    "rootDir": "./src",
    "outDir": "./dist",
    "allowJs": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "composite": true,
    "declaration": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "src/test-utils/**"],
  // Both halves of shared's dual build, for two different reasons. The main process
  // type-checks and requires the CommonJS one (../shared). The ESM one is here because
  // `compile` is `tsc --build . && npm run bundle:preload`, and esbuild picks the export
  // condition from the *import kind*, not the output format - preload.ts's `import` of
  // shared resolves through the "import" condition into dist/esm even though the bundle is
  // emitted as CJS. Without this second reference, `npm --workspace=workspaces/electron-app
  // run compile` on a tree where shared was never built would bundle against a directory
  // that does not exist yet.
  "references": [{ "path": "../shared" }, { "path": "../shared/tsconfig.esm.json" }],
  "ts-node": {
    // The TypeORM CLI (migration:generate/run/revert) runs through ts-node against this
    // tsconfig. Type-checking is skipped here (ts-node 10's checker predates this repo's
    // TypeScript version and misresolves @types/node through the workspace hoist) - `tsc
    // --build` is still what type-checks the project for `npm run build`.
    "transpileOnly": true
  }
}
