{
  "name": "@electron-angular-boilerplate/shared",
  "version": "0.0.1",
  "description": "Electron Angular Boilerplate - shared workspace.",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo tsconfig.esm.tsbuildinfo",
    "dev": "npm run watch",
    "compile": "node scripts/write-dist-manifests.mjs && tsc --build . tsconfig.esm.json --verbose",
    "build": "npm run clean && npm run compile",
    "build:prod": "node scripts/write-dist-manifests.mjs && tsc --build . tsconfig.esm.json",
    "watch": "node scripts/write-dist-manifests.mjs && tsc --build . tsconfig.esm.json --watch",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "Stijn Beeckmans",
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "zod": "^4.5.4"
  }
}
