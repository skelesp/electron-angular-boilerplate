# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Database
/data
workspaces/electron-app/data

# Ignore node_modules and dist in all workspace apps (Angular, Electron, etc.)
workspaces/*/node_modules
workspaces/*/dist
workspaces/angular-app/.angular
workspaces/electron-app/renderer

# electron-builder packaging output
/release

# Test coverage output
workspaces/*/coverage

# Playwright e2e output
workspaces/e2e/playwright-report
workspaces/e2e/test-results

# Node
/node_modules
npm-debug.log
yarn-error.log

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# Miscellaneous
workspaces/*/*.tsbuildinfo

# System files
.DS_Store
Thumbs.db
