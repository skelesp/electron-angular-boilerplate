{
  // Shared base compilerOptions, extended by every workspace's own tsconfig.json.
  // This file is never compiled directly - each workspace builds independently
  // and manages its own "references" for its own project graph.
  "compilerOptions": {
    "target": "ESNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "preserveSymlinks": true
  }
}
