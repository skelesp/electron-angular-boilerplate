# npm's Arborist crashes with "Cannot read properties of null (reading 'edgesOut')" while
# resolving vitest 4.x's own peer dependency graph (npm 10.9.8 / Node 22, reproduced with
# vitest 4.1.11's optional @vitest/browser-playwright peer). legacy-peer-deps sidesteps the
# buggy recursive peer-set resolution path entirely. Safe to remove once npm ships a fix.
legacy-peer-deps=true
